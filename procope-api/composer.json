{
    "name": "procope/procope-api",
    "description": "API + back-office PHP PDO pour PROCOPE Afrique (inscriptions formations)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpspreadsheet": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
