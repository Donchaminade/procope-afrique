# --- Application ---
APP_ENV=production
APP_URL=https://api.procopeafrique.org
# URL publique du site vitrine (liens CTA dans les e-mails, ex. bouton "Je m'inscris")
SITE_URL=https://procopeafrique.org
APP_DEBUG=0
# Cle secrete aleatoire (sessions / tokens). Generer: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change-me

# --- Base de donnees (Hostinger MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=procope
DB_USER=procope
DB_PASS=

# --- CORS : origines front autorisees ---
# PLUSIEURS origines possibles, separees par des virgules (schema + domaine,
# sans slash final). Production : domaine reel + www + Vercel (garde-fou).
# En local, ajouter dans le vrai .env (ne pas ecraser le SMTP) :
#   http://127.0.0.1:5501 et eventuellement http://localhost:5501
CORS_ORIGINS=https://procopeafrique.org,https://www.procopeafrique.org,https://procopeafrique.vercel.app

# --- SMTP (PHPMailer) ---
# La configuration SMTP vit UNIQUEMENT ici (plus dans l'admin).
# SMTP_USER / SMTP_PASS = authentification uniquement (jamais affiches).
# MAIL_FROM / MAIL_FROM_NAME = From visible des automatisations.
# MAIL_REPLY_TO / MAIL_REPLY_TO_NAME = Reply-To (bouton Repondre).
# MAIL_NOTIFY = destinataires des alertes equipe (TO interne) — valeur par
# defaut du reglage mail_notify (modifiable dans Admin -> Reglages).
# Plusieurs adresses possibles, separees par des virgules (ou des
# points-virgules). Ex. MAIL_NOTIFY=equipe@exemple.com,backup@exemple.com
# Ces trois roles sont independants : SMTP_USER != MAIL_FROM != MAIL_NOTIFY
# est le cas normal (auth vs From visible vs alertes equipe).
# Gmail : si MAIL_FROM != SMTP_USER, ajouter MAIL_FROM comme alias
# « Envoyer des e-mails en tant que » sur le compte SMTP_USER, sinon Gmail
# reecrit le From avec l'adresse d'authentification.
# Gmail ports : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=tls
#   (SMTP_PASS = mot de passe d'application, sans espaces).
# Hostinger : SMTP_PORT=465, SMTP_SECURE=ssl.
# Tant que SMTP_HOST / SMTP_USER sont vides, les e-mails sont journalises
# dans mail_logs mais ne partent pas.
# MAIL_ENABLED = valeur par defaut du master switch (modifiable ensuite dans
# Admin -> Automatisations, stocke en base).
MAIL_ENABLED=1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@procopeafrique.org
MAIL_FROM_NAME="PROCOPE Afrique"
MAIL_REPLY_TO=contact@procopeafrique.org
MAIL_REPLY_TO_NAME="PROCOPE Afrique"
MAIL_NOTIFY=procopeafrique@gmail.com,chaminade.dondah.adjolou@gmail.com

# --- Uploads ---
MAX_UPLOAD_MB=5

# --- Compte super admin de secours (optionnel) ---
# Compte "racine" defini uniquement ici : il n'existe PAS dans la table users
# et n'apparait donc jamais dans la liste des utilisateurs de l'admin.
# Se connecter avec cet identifiant (champ e-mail du login) + le mot de passe
# correspondant au hash. Laisser vide pour desactiver ce compte.
# Generer le hash : php -r "echo password_hash('votre-mdp', PASSWORD_ARGON2ID);"
ROOT_ADMIN_USERNAME=
ROOT_ADMIN_PASSWORD_HASH=
